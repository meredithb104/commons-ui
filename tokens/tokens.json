{
  "$schema": "./tokens.schema.json",
  "$description": "Commons UI design tokens. Source of truth. `npm run tokens` compiles this to src/styles/tokens.css. Every color pair below is checked for WCAG 2.2 contrast by scripts/build-tokens.mjs; the build fails if a pair drops below its required ratio.",

  "font": {
    "family": {
      "sans": { "value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" },
      "mono": { "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "size": {
      "sm": { "value": "0.875rem" },
      "md": { "value": "1rem" },
      "lg": { "value": "1.125rem" },
      "xl": { "value": "1.375rem" },
      "2xl": { "value": "1.75rem" },
      "3xl": { "value": "2.25rem" }
    },
    "lineHeight": {
      "tight": { "value": "1.25" },
      "body": { "value": "1.6" }
    },
    "weight": {
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "bold": { "value": "700" }
    }
  },

  "space": {
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "5": { "value": "1.5rem" },
    "6": { "value": "2rem" },
    "7": { "value": "3rem" }
  },

  "radius": {
    "sm": { "value": "4px" },
    "md": { "value": "8px" },
    "lg": { "value": "14px" },
    "pill": { "value": "999px" }
  },

  "size": {
    "target": { "value": "44px", "$note": "WCAG 2.5.8 Target Size (Minimum) is 24px; 44px meets 2.5.5 Target Size (Enhanced) and Apple/Android guidance." },
    "focusRing": { "value": "3px" },
    "focusOffset": { "value": "2px" },
    "border": { "value": "1px" },
    "borderStrong": { "value": "2px" }
  },

  "motion": {
    "duration": {
      "fast": { "value": "120ms" },
      "base": { "value": "200ms" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  },

  "theme": {
    "light": {
      "color": {
        "bg":            { "value": "#FFFFFF" },
        "bgSubtle":      { "value": "#F4F6F8" },
        "surface":       { "value": "#FFFFFF" },
        "text":          { "value": "#1B1F24", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 7 },
        "textMuted":     { "value": "#4A5561", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5 },
        "border":        { "value": "#6B7580", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "primary":       { "value": "#0B4F8A", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5 },
        "onPrimary":     { "value": "#FFFFFF", "$contrastAgainst": ["primary"], "$minRatio": 4.5 },
        "primaryHover":  { "value": "#083D6B" },
        "accent":        { "value": "#8A3B12", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5 },
        "success":       { "value": "#1E6B3A", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5 },
        "successBg":     { "value": "#E6F4EA" },
        "error":         { "value": "#A11D1D", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 4.5 },
        "errorBg":       { "value": "#FBEAEA" },
        "info":          { "value": "#0B4F8A", "$contrastAgainst": ["infoBg"], "$minRatio": 4.5 },
        "infoBg":        { "value": "#E8F1FA" },
        "focus":         { "value": "#B54708", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3, "$note": "WCAG 2.4.13 Focus Appearance / 1.4.11 Non-text Contrast: ring must reach 3:1 against adjacent colors." },
        "meterTrack":    { "value": "#D9DEE3" },
        "meterFill":     { "value": "#1E6B3A", "$contrastAgainst": ["meterTrack"], "$minRatio": 3 }
      }
    },
    "dark": {
      "color": {
        "bg":            { "value": "#0F1419" },
        "bgSubtle":      { "value": "#171E26" },
        "surface":       { "value": "#1B232C" },
        "text":          { "value": "#F1F4F7", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 7 },
        "textMuted":     { "value": "#B4BEC8", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5 },
        "border":        { "value": "#8A96A3", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "primary":       { "value": "#8CC4F5", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5 },
        "onPrimary":     { "value": "#0B1E30", "$contrastAgainst": ["primary"], "$minRatio": 4.5 },
        "primaryHover":  { "value": "#A9D4F8" },
        "accent":        { "value": "#F2A26B", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5 },
        "success":       { "value": "#7ED49A", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5 },
        "successBg":     { "value": "#12301C" },
        "error":         { "value": "#FFA3A3", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 4.5 },
        "errorBg":       { "value": "#3A1414" },
        "info":          { "value": "#8CC4F5", "$contrastAgainst": ["infoBg"], "$minRatio": 4.5 },
        "infoBg":        { "value": "#12283A" },
        "focus":         { "value": "#FFC66D", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3 },
        "meterTrack":    { "value": "#2C3742" },
        "meterFill":     { "value": "#7ED49A", "$contrastAgainst": ["meterTrack"], "$minRatio": 3 }
      }
    },
    "highContrast": {
      "$description": "Black on white, single accent, thicker borders. Also what forced-colors users get, via the CSS in base.css.",
      "color": {
        "bg":            { "value": "#FFFFFF" },
        "bgSubtle":      { "value": "#FFFFFF" },
        "surface":       { "value": "#FFFFFF" },
        "text":          { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "textMuted":     { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "border":        { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "primary":       { "value": "#0000CC", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "onPrimary":     { "value": "#FFFFFF", "$contrastAgainst": ["primary"], "$minRatio": 7 },
        "primaryHover":  { "value": "#000080" },
        "accent":        { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "success":       { "value": "#005A00", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "successBg":     { "value": "#FFFFFF" },
        "error":         { "value": "#B00000", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 7 },
        "errorBg":       { "value": "#FFFFFF" },
        "info":          { "value": "#0000CC", "$contrastAgainst": ["infoBg"], "$minRatio": 7 },
        "infoBg":        { "value": "#FFFFFF" },
        "focus":         { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "meterTrack":    { "value": "#FFFFFF" },
        "meterFill":     { "value": "#000000", "$contrastAgainst": ["meterTrack"], "$minRatio": 3 }
      }
    }
  }
}
